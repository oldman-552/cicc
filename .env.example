# Local development only. Create .env locally; never commit credentials.
# Generate a URL-safe secret, e.g. openssl rand -hex 32.
POSTGRES_PASSWORD=
CICC_DEMO_MODE=0
CICC_INSECURE_COOKIES=0
# Optional stable MFA key belongs only in a securely managed local environment; see docs/MFA.md.
CICC_MFA_KEY=
# When 1, all authenticated accounts must have enrolled TOTP; demo still bypasses auth.
CICC_REQUIRE_MFA=0
